# Copy to .env and adjust. .env is gitignored.

# Django
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres.
# NOTE: the Homebrew postgresql@16 instance on this machine listens on 5433,
# not the default 5432. Port 5432 is a separate instance running as the
# `postgres` user with password auth. Check with:
#   brew services list
#   grep '^port' /opt/homebrew/var/postgresql@16/postgresql.conf
DATABASE_URL=postgres://michaelhuso@localhost:5433/edh_budget_brewer

# Scryfall. Their API requires a descriptive User-Agent identifying your app;
# do not let an HTTP library pick this for you.
SCRYFALL_USER_AGENT=edh-budget-brewer/0.1 (+https://github.com/husomichael/edh-budget-brewer)

# Read-only public demo. When True the write routes and the Django admin are
# not registered at all, so they 404: no saved decks, no collection, no way to
# change server state. Leave False for local use.
DEMO_MODE=False

# TLS. Turns on SECURE_SSL_REDIRECT, secure-only session and CSRF cookies,
# HSTS, and SECURE_PROXY_SSL_HEADER together -- they are only ever correct
# together. Leave False locally: runserver speaks plain HTTP, and the redirect
# would send every request to an https:// URL nothing is listening on.
HTTPS_ONLY=False

# Deliberately short. HSTS is cached by the browser and cannot be withdrawn on
# demand, so raise it only once the deployment has been good for a while.
# SECURE_HSTS_SECONDS=3600

# Needed in production for the deployed hostname, e.g.
# CSRF_TRUSTED_ORIGINS=https://edh-budget-brewer.onrender.com
CSRF_TRUSTED_ORIGINS=

# Brew response cache TTL, in seconds. The solver is deterministic, so an
# identical request can be served from cache -- measured at 0.39s -> 0.002s.
# 24h, not longer: Scryfall prices move daily and a week-old price is a lie.
# 0 disables caching, which is useful when working on the solver.
BREW_CACHE_SECONDS=86400

# Rate limits. Scoped, because a five-colour brew with an upgrade path is
# ~1.1s of CPU while autocomplete is one indexed query.
BREW_THROTTLE_RATE=20/min
READ_THROTTLE_RATE=120/min

# Shared cache. Leave unset for per-process locmem, which is fine for a demo.
# With more than one worker, locmem means per-worker counters: the effective
# rate limit is WEB_CONCURRENCY x the configured rate.
# CACHE_URL=rediscache://localhost:6379/0
